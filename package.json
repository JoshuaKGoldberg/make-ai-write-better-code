		"@slidev/types": "53.1.0",
		"@takumi-rs/core": "2.20.0",
		"@takumi-rs/helpers": "2.20.0",
		"@types/css-tree": "2.3.11",
		"@types/fontkit": "2.0.8",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.27",
		"@vue/server-renderer": "3.5.45",
		"console-fail-test": "0.10.0",
		"cspell": "10.4.0",
		"css-tree": "3.2.1",
		"eslint": "10.14.0",
		"eslint-plugin-jsdoc": "65.4.0",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.10.0",
		"fontkit": "3.0.0",
		"husky": "9.1.7",
		"jszip": "3.10.1",
		"knip": "6.45.0",
		"linkedom": "0.18.15",
		"lint-staged": "17.6.0",
		"lz-string": "1.5.0",

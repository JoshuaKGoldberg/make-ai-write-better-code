{
	"name": "make-ai-write-better-code",
	"version": "0.0.0",
	"private": true,
	"description": "Slides for my React Summit US 2026 talk on guardrailing AI coding agents with skills, static analysis, tests, and review.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/make-ai-write-better-code.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "git@joshuakgoldberg.com"
	},
	"type": "module",
	"scripts": {
		"build": "slidev build",
		"build:pptx": "node scripts/pptx/index.ts --out dist/make-ai-write-better-code.pptx",
		"dev": "slidev --open false",
		"export": "slidev export",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
